# =====================================================================
# PaniniPano server — environment template
# Copy to .env for local dev. In production Coolify provides these.
# Server FAILS TO START if a required var is missing.
# =====================================================================

# --- Runtime -----------------------------------------------------------
NODE_ENV=development
PORT=3030
# Where the app lives publicly. The app is path-agnostic internally
# (Traefik StripPrefix handles /paninipano), but signed-download links
# and Whop redirect URLs need the full external URL.
PUBLIC_BASE_URL=http://localhost:3030
# Path to the static site root. Defaults to the parent dir (where index.html lives).
STATIC_ROOT=
# Path to the persistent data dir (SQLite file + generated packages).
DATA_DIR=./data

# --- Login gate (basic auth) -------------------------------------------
# Subastas-style temporary gate. Skipped if DISABLE_BASIC_AUTH=true.
# Webhooks are always excluded (Whop has no creds; HMAC protects them).
BASIC_AUTH_USER=paninipano
BASIC_AUTH_PASS=change-me-before-deploy
DISABLE_BASIC_AUTH=true

# --- Download token signing -------------------------------------------
# 32+ char random string. Used to HMAC-sign download URLs.
# `openssl rand -hex 32`
DOWNLOAD_SIGNING_SECRET=replace-with-32-byte-hex-secret
DOWNLOAD_TOKEN_TTL_HOURS=24

# --- Whop (NOT CONNECTED YET — Dennis fork) ----------------------------
# Leave blank in dev → server runs in safe stub mode (clear error on checkout).
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
# JSON map: { "<bundleId>": "<whop_product_id>" }
# e.g. {"vintage-botanicals":"prod_abc","fading-films":"prod_xyz"}
WHOP_BUNDLE_PRODUCT_MAP_JSON={}
# Where Whop redirects buyers after a successful checkout (signed link).
WHOP_SUCCESS_URL=
WHOP_CANCEL_URL=
